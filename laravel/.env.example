APP_NAME=Facturo
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_TIMEZONE=Africa/Casablanca
APP_URL=https://facturo.ma

# Monnaie de référence du plafond Auto-Entrepreneur
FACTURO_BASE_CURRENCY=MAD
FACTURO_DEFAULT_CEILING=200000

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=facturo
DB_USERNAME=facturo
DB_PASSWORD=

QUEUE_CONNECTION=redis
CACHE_STORE=redis
SESSION_DRIVER=redis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

HORIZON_PREFIX=facturo_horizon

BROADCAST_CONNECTION=reverb
REVERB_APP_ID=facturo
REVERB_APP_KEY=
REVERB_APP_SECRET=
REVERB_HOST=ws.facturo.ma
REVERB_PORT=443
REVERB_SCHEME=https

MAIL_MAILER=smtp
MAIL_FROM_ADDRESS=factures@facturo.ma
MAIL_FROM_NAME="${APP_NAME}"

# Laravel Cashier (abonnements SaaS)
CASHIER_CURRENCY=mad
CASHIER_CURRENCY_LOCALE=fr
STRIPE_KEY=
STRIPE_SECRET=
STRIPE_WEBHOOK_SECRET=
